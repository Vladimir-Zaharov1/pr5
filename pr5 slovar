countries = ["Россия", "Франция", "Япония", "Бразилия"]
capitals = ["Москва", "Париж", "Токио", "Бразилиа"]
world = {}

for position in range(len(countries)):
    world[countries[position]] = capitals[position]

choice = input("Введите страну: ")
if choice in world:
    print("Столица страны", choice, "—", world[choice])
else:
    print("Такой страны нет в списке")
