line = "программирование"
char_count = {}

for symbol in line:
    if symbol in char_count:
        char_count[symbol] += 1
    else:
        char_count[symbol] = 1

print(char_count)


sentence = "кот собака кот птица собака кот рыба"
word_count = {}

for word in sentence.split():
    word_count[word] = word_count.get(word, 0) + 1

top_word = ""
for word in word_count:
    if top_word == "" or word_count[word] > word_count[top_word]:
        top_word = word

print(word_count)
print("Самое частое слово:", top_word)


