total = 0
value = int(input("Введите число (0 — стоп): "))

while value != 0:
    total += value
    value = int(input("Введите число (0 — стоп): "))

print("Сумма введённых чисел:", total)


num = int(input("Введите натуральное число: "))
digits = 0

while num > 0:
    num //= 10
    digits += 1

print("Количество цифр:", digits)


num = int(input("Введите натуральное число: "))
digit_sum = 0

while num > 0:
    digit_sum += num % 10
    num //= 10

print("Сумма цифр:", digit_sum)


num = int(input("Введите натуральное число: "))
reversed_num = 0

while num > 0:
    reversed_num = reversed_num * 10 + num % 10
    num //= 10

print("Число наоборот:", reversed_num)


