limit = int(input("Введите число n: "))
first, second = 0, 1

while first <= limit:
    print(first, end=" ")
    first, second = second, first + second


import random

secret = random.randint(1, 100)
tries = 0
guess = 0

while guess != secret:
    guess = int(input("Ваш вариант: "))
    tries += 1
    if guess < secret:
        print("Больше")
    elif guess > secret:
        print("Меньше")

print("Угадал!Попыток:", tries)
